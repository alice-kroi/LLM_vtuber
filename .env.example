# ============================================================
# 🔑 必填：豆包大模型（ark.cn-beijing.volces.com）
# ============================================================
# 在 https://console.volcengine.com/ark 创建推理接入点后获取 API Key
Doubao_API_KEY=your-doubao-api-key-here
Doubao_API_URL=https://ark.cn-beijing.volces.com/api/v3

# ============================================================
# 🎤 可选：火山引擎云端 TTS
# 从 https://console.volcengine.com/speech → 应用管理 → Access Token 复制
# 优先级（自动查找）：DOUBAO_API_KEY → VOLCENGINE_API_KEY → ARK_API_KEY → TTS_KEY
# ============================================================
VOLCENGINE_API_KEY=

# ============================================================
# 📺 可选：B 站 SESSDATA（提高弹幕接收等级至 100+）
# 浏览器登录 bilibili.com → F12 → Application → Cookies → SESSDATA
# ============================================================
BILIBILI_SESSDATA=

# ============================================================
# 📚 可选：Milvus + MinIO（RAG 知识库）
# 如果用本地 Milvus 无需 Token；远程 Milvus 需填 MILVUS_TOKEN
# MinIO 用于存储知识库原始文件（可选）
# ============================================================
MILVUS_TOKEN=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
KNOWLEDGE_BUCKET=knowledge-files
